{
  "name": "@hallmaster/backend",
  "type": "module",
  "exports": {
    "./schemas": "./src/schemas/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsdown",
    "start": "node dist/index.mjs",
    "start:prod": "prisma migrate deploy && node dist/index.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:cov": "vitest run --coverage",
    "prisma:dev": "prisma dev",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@hallmaster/docker.js": "^0.0.28",
    "@hono/node-server": "^2.1.1",
    "@hono/standard-validator": "^0.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.4.1",
    "@scalar/hono-api-reference": "^0.12.6",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.4",
    "hono": "^4.13.9",
    "hono-openapi": "^1.3.3",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  }
}
