generator client {
  provider        = "prisma-client"
  output          = "generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
}

model User {
  id          String   @id
  username    String
  displayName String?  @map("display_name")
  avatar      String?
  role        UserRole @default(ADMIN)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([role], where: { role: "OWNER" })
}

model Bot {
  id                   String                @id
  token                String
  totalShards          Int                   @map("total_shards")
  webhookTokenHash     String?               @map("webhook_token_hash")
  clusters             Cluster[]
  containerImage       ContainerImage?
  environmentVariables EnvironmentVariable[]
  clusterSamples       ClusterSample[]
  alerts               Alert[]

  @@map("bot")
}

model ContainerImage {
  id         String  @id @default(uuid())
  serverName String  @unique @default("host.docker.internal:5000") @map("server_name")
  image      String
  tag        String  @default("latest")
  username   String?
  password   String?
  botId      String  @unique @map("bot_id")
  bot        Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("container_image")
}

enum ClusterDesiredStatus {
  RUNNING
  STOPPED
}

model Cluster {
  id            Int
  botId         String               @map("bot_id")
  containerId   String               @map("container_id")
  desiredStatus ClusterDesiredStatus @map("desired_status")
  shardIds      Int[]                @map("shard_ids")
  bot           Bot                  @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, id])
  @@map("cluster")
}

model EnvironmentVariable {
  botId String @map("bot_id")
  key   String
  value String
  bot   Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, key])
  @@map("environment_variable")
}

model ClusterSample {
  botId            String   @map("bot_id")
  clusterId        Int      @map("cluster_id")
  at               DateTime @db.Timestamptz(3)
  cpuPercentage    Float    @map("cpu_percentage")
  memoryUsage      BigInt   @map("memory_usage")
  memoryPercentage Float    @map("memory_percentage")
  bot              Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, clusterId, at])
  @@index([at])
  @@map("cluster_sample")
}

enum AlertKind {
  STOPPED
  CRASH_LOOP
  OOM_KILLED
  DEPLOY_FAILED
}

model Alert {
  id         String    @id @default(uuid())
  botId      String    @map("bot_id")
  clusterId  Int       @map("cluster_id")
  kind       AlertKind
  message    String
  startedAt  DateTime  @default(now()) @map("started_at")
  resolvedAt DateTime? @map("resolved_at")
  bot        Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, resolvedAt])
  @@index([botId, startedAt])
  @@map("alert")
}
