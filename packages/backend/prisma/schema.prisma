generator client {
  provider        = "prisma-client"
  output          = "generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
}

model User {
  id          String   @id
  username    String
  displayName String?  @map("display_name")
  avatar      String?
  role        UserRole @default(ADMIN)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([role], where: { role: "OWNER" })
}

model Bot {
  id             String          @id
  token          String
  totalShards    Int             @map("total_shards")
  clusters       Cluster[]
  containerImage ContainerImage?

  @@map("bot")
}

model ContainerImage {
  id         String  @id @default(uuid())
  serverName String  @unique @default("host.docker.internal:5000") @map("server_name")
  image      String
  tag        String  @default("latest")
  username   String?
  password   String?
  botId      String  @unique @map("bot_id")
  bot        Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("container_image")
}

enum ClusterDesiredStatus {
  RUNNING
  STOPPED
}

model Cluster {
  id            Int
  botId         String               @map("bot_id")
  containerId   String               @map("container_id")
  desiredStatus ClusterDesiredStatus @map("desired_status")
  shardIds      Int[]                @map("shard_ids")
  bot           Bot                  @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, id])
  @@map("cluster")
}
